# Copy to .env and `node --env-file=.env src/index.js`, or export these.

# --- Alexa+ brain for the simulator (pick one; with neither, an offline planner is used) ---
# ANTHROPIC_API_KEY=sk-ant-...
# SAATHI_USE_BEDROCK=true            # Claude on Amazon Bedrock via the Mantle endpoint (uses your AWS credentials)

# --- MCP authorization (SAATHI_AUTH_MODE = none | static | cognito) ---
# SAATHI_MCP_TOKEN=change-me         # static: elder device token (all scopes)
# SAATHI_FAMILY_TOKEN=change-me-too  # static: family device token (saathi/family only)
# SAATHI_COGNITO_USER_POOL_ID=us-east-1_xxxx
# SAATHI_COGNITO_CLIENT_IDS=abc,def
# SAATHI_COGNITO_DOMAIN=saathi-xxxx
# SAATHI_PUBLIC_URL=https://your-host   # used in OAuth protected resource metadata

# --- Ring doorbell webhook ---
# SAATHI_RING_WEBHOOK_SECRET=change-me

# --- Switch every AWS integration on at once (uses outputs of the CDK stack) ---
# SAATHI_USE_AWS=true
# AWS_REGION=us-east-1
# SAATHI_TABLE=...
# SAATHI_EVENT_BUS=...
# SAATHI_FAMILY_TOPIC_ARN=...
# SAATHI_MEDIA_BUCKET=...
# SAATHI_ESCALATION_SFN_ARN=...

# --- ...or one at a time ---
# SAATHI_AWS_TRANSLATE=true
# SAATHI_AWS_COMPREHEND=true
# SAATHI_AWS_POLLY=true

# --- Exposing the local server through a tunnel (ngrok, cloudflared) for a real Alexa+ device ---
# HOST=0.0.0.0
# SAATHI_ALLOWED_HOSTS=your-subdomain.ngrok.app
