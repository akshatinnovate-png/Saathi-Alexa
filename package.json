{
  "name": "saathi-alexa",
  "version": "1.0.0",
  "description": "Saathi: an Alexa+ MCP server (Streamable HTTP, spec 2025-11-25) that helps elders living with memory loss, disability or a language gap stay connected to the families who love them.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "seed:aws": "node scripts/seed-aws.js",
    "inspect": "npx @modelcontextprotocol/inspector",
    "eval": "node evals/safety.js && node evals/routing.js",
    "a11y": "node scripts/a11y.js",
    "smoke": "node scripts/smoke.js",
    "setup": "node scripts/setup.js",
    "demo": "node scripts/demo.js",
    "add-ring": "npm install --no-save --no-audit --no-fund ring-client-api@14.3.0",
    "build:core": "node scripts/build-core.js",
    "check:core": "node scripts/build-core.js --check",
    "key-status": "node scripts/key.js status",
    "protect-key": "node scripts/key.js protect",
    "restore-key": "node scripts/key.js restore",
    "e2e": "node scripts/e2e.js",
    "lint": "eslint ."
  },
  "keywords": [
    "alexa-plus",
    "mcp",
    "model-context-protocol",
    "accessibility",
    "eldercare",
    "aws",
    "bedrock"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1158.0",
    "@aws-sdk/client-comprehend": "^3.1158.0",
    "@aws-sdk/client-dynamodb": "^3.1158.0",
    "@aws-sdk/client-eventbridge": "^3.1158.0",
    "@aws-sdk/client-polly": "^3.1158.0",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-secrets-manager": "^3.1158.0",
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@aws-sdk/client-sfn": "^3.1158.0",
    "@aws-sdk/client-sns": "^3.1158.0",
    "@aws-sdk/client-translate": "^3.1158.0",
    "@aws-sdk/lib-dynamodb": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "asl-validator": "^4.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "globals": "^17.13.0",
    "playwright-core": "1.64",
    "rxjs": "^7.8.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
