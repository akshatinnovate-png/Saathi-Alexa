{"task": "convert {n} {a} to {b}", "steps": ["open https://www.google.com/search?q={n:url}+{a:url}+to+{b:url}"], "say": "Here's {n} {a} in {b}."}
{"task": "how many {b} is {n} {a}", "steps": ["open https://www.google.com/search?q={n:url}+{a:url}+to+{b:url}"], "say": "Here's {n} {a} in {b}."}
{"task": "play {rhyme} for kids", "steps": ["open https://www.youtube.com/results?search_query={rhyme:url}+for+kids", "click \"{rhyme}\"", "sound on", "skip ads"], "say": "Playing {rhyme}."}
{"task": "tell a story about {rhyme}", "steps": ["open https://www.youtube.com/results?search_query={rhyme:url}+story+for+kids", "click \"{rhyme}\"", "sound on", "skip ads"], "say": "Here's a story about {rhyme}."}
{"task": "post {text} on twitter", "steps": ["open https://x.com/intent/post?text={text:url}", "wait for \"Post\""], "say": "Your post is ready; press Post when you're happy with it."}
{"task": "share {text} on whatsapp", "steps": ["open https://wa.me/?text={text:url}", "wait for \"Continue to Chat\"", "click \"Continue to Chat\""], "say": "Choose who to send it to on WhatsApp."}
{"task": "share {text} on telegram", "steps": ["open https://t.me/share/url?url={text:url}"], "say": "Choose who to share it with on Telegram."}
{"task": "ping {host}", "steps": ["run Test-Connection {host} -Count 4 | Select-Object Address,ResponseTime | Out-String"], "say": ""}
{"task": "is {host} down", "steps": ["run if (Test-Connection {host} -Count 2 -Quiet) {{ '{host} is up' }} else {{ '{host} is not answering' }}"], "say": ""}
{"task": "what is the ip of {host}", "steps": ["run (Resolve-DnsName {host} -Type A | Select-Object -First 1).IPAddress"], "say": ""}
{"task": "buy the book {book} on amazon", "steps": ["open https://www.amazon.in/s?k={book:url}&i=stripbooks", "click \"{book}\"", "wait for \"Add to Cart\"", "click \"Add to Cart\"", "expect \"Added to Cart\""], "say": "Added {book} to your Amazon cart."}
{"task": "summary of the book {book}", "steps": ["research {book} book summary"], "say": ""}
{"task": "{book} audiobook", "steps": ["open https://www.youtube.com/results?search_query={book:url}+audiobook", "click \"{book}\"", "sound on", "skip ads"], "say": "Playing the {book} audiobook."}
{"task": "pay {bill} online", "steps": ["open https://www.google.com/search?q=pay+{bill:url}+online"], "say": "Here's where to pay the {bill}; I won't pay without you."}
{"task": "pay my {bill} with {app}", "steps": ["open https://www.google.com/search?q=pay+{bill:url}+on+{app:url}"], "say": "Here's how to pay the {bill} with {app}."}
{"task": "{service} online", "steps": ["open https://www.google.com/search?q={service:url}+official+site"], "say": "Here's the official site for {service}."}
{"task": "how to {service}", "steps": ["open https://www.youtube.com/results?search_query=how+to+{service:url}", "click \"{service}\"", "sound on", "skip ads"], "say": "Here's a video on how to {service}."}
{"task": "documents needed to {service}", "steps": ["open https://www.google.com/search?q=documents+required+to+{service:url}"], "say": "Here are the documents needed to {service}."}
{"task": "open {bank} net banking", "steps": ["open https://www.google.com/search?q={bank:url}+net+banking+login+official"], "say": "Here's {bank} net banking; you log in yourself."}
{"task": "{bank} customer care number", "steps": ["open https://www.google.com/search?q={bank:url}+customer+care+number"], "say": "Here's the {bank} customer care number."}
{"task": "{bank} fd interest rates", "steps": ["open https://www.google.com/search?q={bank:url}+fd+interest+rates"], "say": "Here are {bank} FD rates."}
{"task": "{bank} branch near me", "steps": ["open https://www.google.com/maps/search/{bank:url}+branch+near+me"], "say": "Here are {bank} branches near you."}
{"task": "{bank} ifsc code in {city}", "steps": ["open https://www.google.com/search?q={bank:url}+ifsc+code+{city:url}"], "say": "Here's the {bank} IFSC in {city}."}
