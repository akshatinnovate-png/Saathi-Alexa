{"task": "send an email to {email} saying {body}", "steps": ["open https://mail.google.com/mail/?view=cm&fs=1&to={email:url}&body={body:url}", "wait for \"Send\"", "click \"Send\"", "expect \"Message sent\""], "say": "Sent the email to {email}."}
