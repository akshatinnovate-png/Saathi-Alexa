{"task": "search {query} on youtube", "steps": ["open https://www.youtube.com/results?search_query={query:url}", "expect \"Filters\""], "say": "Here are YouTube results for {query}."}
{"task": "play {song} on youtube", "steps": ["open https://www.youtube.com/results?search_query={song:url}", "click \"{song}\"", "sound on", "skip ads"], "say": "Playing {song}."}
{"task": "play the first video", "steps": ["click \"views\"", "sound on", "skip ads"], "say": "Playing the first video."}
{"task": "open my youtube history", "steps": ["open https://www.youtube.com/feed/history", "expect \"Watch history\""], "say": "Here's your watch history."}
{"task": "open my youtube subscriptions", "steps": ["open https://www.youtube.com/feed/subscriptions", "expect \"Subscriptions\""], "say": "Here are your subscriptions."}
{"task": "play {song} on spotify", "steps": ["open https://open.spotify.com/search/{song:url}", "wait for \"Songs\"", "double \"{song}\"", "sound on"], "say": "Playing {song} on Spotify."}
{"task": "watch {show} on netflix", "steps": ["open https://www.netflix.com/search?q={show:url}", "wait 3", "click \"{show}\""], "say": "Opening {show} on Netflix."}
{"task": "search {show} on hotstar", "steps": ["open https://www.hotstar.com/in/explore?search_query={show:url}"], "say": "Here's {show} on Hotstar."}
{"task": "play some {genre} music", "steps": ["open https://www.youtube.com/results?search_query={genre:url}+music+playlist", "click \"{genre}\"", "sound on", "skip ads"], "say": "Playing {genre} music."}
{"task": "play bhajans", "steps": ["open https://www.youtube.com/results?search_query=morning+bhajans", "click \"Bhajan\"", "sound on", "skip ads"], "say": "Playing bhajans."}
{"task": "skip the ad", "steps": ["skip ads"], "say": "Done."}
{"task": "turn on captions", "steps": ["key c"], "say": "Captions toggled."}
{"task": "make the video faster", "steps": ["key shift+."], "say": "Faster."}
{"task": "make the video slower", "steps": ["key shift+,"], "say": "Slower."}
{"task": "go forward 10 seconds", "steps": ["key l"], "say": "Skipped ahead 10 seconds."}
{"task": "go back 10 seconds", "steps": ["key j"], "say": "Went back 10 seconds."}
{"task": "add {item} to my amazon cart", "steps": ["open https://www.amazon.in/s?k={item:url}", "click \"{item}\"", "wait for \"Add to Cart\"", "click \"Add to Cart\"", "expect \"Added to Cart\""], "say": "Added {item} to your Amazon cart."}
{"task": "find {item} on amazon", "steps": ["open https://www.amazon.in/s?k={item:url}", "expect \"results\""], "say": "Here are Amazon results for {item}."}
{"task": "find the best rated {item} on amazon", "steps": ["open https://www.amazon.in/s?k={item:url}&s=review-rank", "expect \"results\""], "say": "Here are the best rated {item} on Amazon."}
{"task": "find the cheapest {item} on amazon", "steps": ["open https://www.amazon.in/s?k={item:url}&s=price-asc-rank", "expect \"results\""], "say": "Here are the cheapest {item} on Amazon."}
{"task": "open my amazon cart", "steps": ["open https://www.amazon.in/gp/cart/view.html", "expect \"Shopping Cart\""], "say": "Here's your Amazon cart."}
{"task": "show my amazon orders", "steps": ["open https://www.amazon.in/gp/your-account/order-history", "expect \"Your Orders\""], "say": "Here are your Amazon orders."}
{"task": "track my amazon order", "steps": ["open https://www.amazon.in/gp/your-account/order-history", "wait for \"Track package\"", "click \"Track package\""], "say": "Here's the tracking."}
{"task": "remove {item} from my amazon cart", "steps": ["open https://www.amazon.in/gp/cart/view.html", "wait for \"{item}\"", "click \"Delete\"", "expect \"was removed\""], "say": "Removed {item} from your cart."}
{"task": "add {item} to my flipkart cart", "steps": ["open https://www.flipkart.com/search?q={item:url}", "key escape", "click \"{item}\"", "wait for \"ADD TO CART\"", "click \"ADD TO CART\"", "expect \"GO TO CART\""], "say": "Added {item} to your Flipkart cart."}
{"task": "find {item} on flipkart", "steps": ["open https://www.flipkart.com/search?q={item:url}", "key escape"], "say": "Here are Flipkart results for {item}."}
{"task": "open my flipkart cart", "steps": ["open https://www.flipkart.com/viewcart", "expect \"Cart\""], "say": "Here's your Flipkart cart."}
{"task": "find {item} on myntra", "steps": ["open https://www.myntra.com/{item:url}"], "say": "Here's {item} on Myntra."}
{"task": "find {item} on ajio", "steps": ["open https://www.ajio.com/search/?text={item:url}"], "say": "Here's {item} on AJIO."}
{"task": "compare prices of {item}", "steps": ["research {item} price amazon flipkart"], "say": ""}
{"task": "send {message} to {name} on whatsapp", "steps": ["open https://web.whatsapp.com", "wait for \"Search\"", "click \"Search\"", "type {name}", "wait 1.5", "click \"{name}\"", "wait for \"Type a message\"", "click \"Type a message\"", "type {message}", "key enter"], "say": "Sent \"{message}\" to {name}."}
{"task": "message {name} on whatsapp saying {message}", "steps": ["open https://web.whatsapp.com", "wait for \"Search\"", "click \"Search\"", "type {name}", "wait 1.5", "click \"{name}\"", "wait for \"Type a message\"", "click \"Type a message\"", "type {message}", "key enter"], "say": "Sent \"{message}\" to {name}."}
{"task": "open whatsapp chat with {name}", "steps": ["open https://web.whatsapp.com", "wait for \"Search\"", "click \"Search\"", "type {name}", "wait 1.5", "click \"{name}\""], "say": "Here's your chat with {name}."}
