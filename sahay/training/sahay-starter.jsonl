{"task": "how much storage is left", "steps": ["run Get-PSDrive C | Select-Object @{n='FreeGB';e={[math]::Round($_.Free/1GB,1)}},@{n='UsedGB';e={[math]::Round($_.Used/1GB,1)}}"], "say": ""}
{"task": "how much ram is being used", "steps": ["run $o=Get-CimInstance Win32_OperatingSystem; '{0:N1} GB free of {1:N1} GB' -f ($o.FreePhysicalMemory/1MB),($o.TotalVisibleMemorySize/1MB)"], "say": ""}
{"task": "what is my ip address", "steps": ["run (Invoke-RestMethod https://api.ipify.org)"], "say": ""}
{"task": "check my internet speed", "steps": ["open https://fast.com", "wait 15", "read"], "say": ""}
{"task": "update all my apps", "steps": ["run winget upgrade --all --accept-source-agreements --accept-package-agreements --disable-interactivity"], "say": "All apps are updated."}
{"task": "uninstall {app}", "steps": ["run winget uninstall --name \"{app}\" --disable-interactivity"], "say": "Uninstalled {app}."}
{"task": "create a folder called {name} on the desktop", "steps": ["run New-Item -ItemType Directory -Path \"$([Environment]::GetFolderPath('Desktop'))\\{name}\" | Out-Null; 'done'"], "say": "Created the folder {name} on your desktop."}
{"task": "open the folder {name}", "steps": ["run $f = Get-ChildItem -Path $env:USERPROFILE -Directory -Recurse -Depth 3 -Filter '*{name}*' -ErrorAction SilentlyContinue | Select-Object -First 1; if ($f) { Start-Process $f.FullName; $f.FullName } else { 'not found' }"], "say": ""}
{"task": "show my recent downloads", "steps": ["run Get-ChildItem \"$env:USERPROFILE\\Downloads\" | Sort-Object LastWriteTime -Descending | Select-Object -First 8 Name, LastWriteTime"], "say": ""}
{"task": "open the latest download", "steps": ["run $f = Get-ChildItem \"$env:USERPROFILE\\Downloads\" -File | Sort-Object LastWriteTime -Descending | Select-Object -First 1; Start-Process $f.FullName; $f.Name"], "say": "Opened your latest download."}
{"task": "zip the folder {name}", "steps": ["run $f = Get-ChildItem -Path $env:USERPROFILE -Directory -Recurse -Depth 3 -Filter '{name}' -ErrorAction SilentlyContinue | Select-Object -First 1; Compress-Archive -Path $f.FullName -DestinationPath \"$($f.FullName).zip\" -Force; \"$($f.FullName).zip\""], "say": "Zipped {name}."}
{"task": "open {book} solutions on knowledgeboat", "steps": ["open https://www.google.com/search?q=site%3Aknowledgeboat.com+{book:url}", "click \"KnowledgeBoat\""], "say": "Here are the {book} solutions."}
{"task": "open khan academy {topic}", "steps": ["open https://www.khanacademy.org/search?page_search_query={topic:url}"], "say": "Here's {topic} on Khan Academy."}
{"task": "explain {topic} with a video", "steps": ["open https://www.youtube.com/results?search_query={topic:url}+explained", "click \"{topic}\"", "sound on", "skip ads"], "say": "Here's a video explaining {topic}."}
{"lesson": "Amazon and Flipkart product links usually open in a new tab; after clicking a product the product page is the window in front."}
{"lesson": "On Amazon, the site's own search box is called Search Amazon; never type product searches into the browser's address bar."}
{"lesson": "Amazon price filters in links are in paise: 30,000 to 40,000 rupees is rh=p_36%3A3000000-4000000."}
{"lesson": "Confirm adding to a cart with new words like Added to Cart, never with a cart count that was already on the page."}
{"lesson": "Never press Buy Now, Place Order or Proceed to Pay without the user saying so."}
{"lesson": "When choosing a product, prefer 4 stars or more with many reviews, skip Sponsored results, and say the price you saw."}
{"lesson": "Flipkart shows a login pop-up first; press escape or click its close button."}
{"lesson": "WhatsApp Web needs a one-time QR login on the phone; if the QR code is showing, tell the user to scan it."}
{"lesson": "YouTube: play and pause only with media play and media pause; never press k or click the video to toggle."}
{"lesson": "For full screen video on YouTube press f after the video is in front; escape leaves full screen."}
{"lesson": "After opening any video or song, add sound on and skip ads."}
{"lesson": "Use direct links (search pages, ms-settings pages, Gmail compose links) instead of clicking through menus."}
{"lesson": "Close cookie banners and sign-in nags (Not now, Maybe later, No thanks) before anything else."}
{"lesson": "If something is not visible, scroll down and look again before deciding it is missing."}
{"lesson": "Tabs close with ctrl+w; apps close with alt+f4 after focusing them. Never close Program Manager or Windows system windows."}
{"lesson": "Typing goes where the cursor is: click the box first, then type."}
{"lesson": "After a search, click the result's title words, not the address bar or the tab."}
{"lesson": "expect must name words that appear only after success, never symbols like ₹ alone."}
{"lesson": "For files, folders and system information use run with PowerShell instead of clicking in File Explorer."}
{"lesson": "Ask before deleting files, uninstalling apps, shutting down or restarting the computer."}
{"lesson": "Never type passwords, OTPs, card or bank details unless the user gave them for this task."}
{"lesson": "Prices and specs change: when comparing products use research and fetch, then give the best three with reasons."}
{"lesson": "If a page is still loading, wait for words that will appear rather than clicking blindly."}
{"lesson": "Windows settings switches are named after the setting (Wi-Fi, Bluetooth); click it and expect On or Off."}
{"lesson": "Gmail compose link: https://mail.google.com/mail/?view=cm&fs=1&to=ADDRESS&su=SUBJECT&body=TEXT."}
{"lesson": "Google Maps directions link: https://www.google.com/maps/dir/?api=1&destination=PLACE."}
{"lesson": "Edge opens a URL with open msedge followed by the link; Chrome with open chrome followed by the link."}
{"lesson": "When the user corrects you, follow the correction exactly and remember it as a lesson."}
{"lesson": "If the same step failed twice, try a different way: another word on screen, the keyboard, a direct link or a search."}
{"lesson": "Keep replies to one short sentence; say what was done and anything the user must do next."}
